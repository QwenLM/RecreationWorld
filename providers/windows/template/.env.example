# Copy this file to .env.windows and fill real credentials locally.
# Do not commit real Windows or API credentials.

# Prepared Windows host with OpenSSH enabled and an active desktop session.
RB_WINDOWS_HOST=
RB_WINDOWS_USERNAME=Administrator
RB_WINDOWS_PASSWORD=

# Model under test. run_one.py maps these into the Windows orchestrator's
# ANTHROPIC_* env names for recreation.
RB_AGENT_CLI=claude
AGENT_CLI=claude
RB_MODEL=your-model-name
RB_MODEL_BASE_URL=https://api.example.com/v1
RB_MODEL_API_KEY=sk-xxx
TEMPERATURE=1.0
MAX_ITERATIONS=100
MAX_TOKENS_LIMIT=128000
CONTEXT_1M=false
THINKING_EFFORT=max
# AUTO_COMPACT_WINDOW is accepted as an alias
# for RB_CLAUDE_CODE_AUTO_COMPACT_WINDOW by the Windows orchestrator.
AUTO_COMPACT_WINDOW=
RB_CLAUDE_CODE_AUTO_COMPACT_WINDOW=
PROXY_THINKING_CONFIG=OFF
USE_NATIVE_ANTHROPIC=true
FORCE_NON_STREAM=false
NATIVE_STREAM_BUFFER_ENABLED=true
STREAM_BUFFER_RETRY_ENABLED=false
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
RB_API_TIMEOUT_MS=1800000
RB_MCP_TOOL_TIMEOUT=180000
# Retry only transient Claude upstream connection failures (for example
# ConnectionRefused). Each attempt gets a separate trajectory.attempt-N.jsonl.
RB_CLAUDE_MAX_RETRIES=2
RB_CLAUDE_RETRY_DELAY=30
# Use this when the Windows host already has Python packages and agent
# CLIs installed. This avoids slow/flaky native dependency reinstall per task.
RB_WINDOWS_SKIP_DEP_INSTALL=1
RB_WINDOWS_SKIP_AGENT_INSTALL=1
# Optional suffix for C:\rb_pipeline\<vm_tid>. Use this for retries on a
# long-lived host to avoid stale file locks from an interrupted previous run.
RB_WINDOWS_VM_TASK_DIR_SUFFIX=
# Dedicated Windows runs can leave task-scoped wrapper processes after
# an interrupted build. This only cleans processes whose command line contains
# the current task directory.
RB_WINDOWS_CLEAN_STALE_BUILD_PROCESSES=1
# Current qwen CUA Driver releases expose qwen-cua-driver; trycua releases use
# cua-driver. Set this explicitly for pre-baked Windows images.
RB_CUA_DRIVER_BINARY=qwen-cua-driver
# Qwen CUA Driver 0.7.3 uses the long-lived daemon pipe below. Pin the runtime
# ref so every run verifies/upgrades the provisioned driver to the release version.
RB_CUA_DRIVER_SOCKET=\\.\pipe\cua-driver
RB_CUA_DRIVER_REF=qwen:0.7.3
# strict requires get_window_state/UIA. screenshot directly verifies only
# list_windows + get_desktop_state. warn attempts strict UIA first, then logs
# a warning and uses the screenshot check only when the UIA helper is unavailable.
RB_CUA_PREFLIGHT_MODE=strict

# Reference build timeout used by setup/environment-validation runs.
# Keep release runs high; for batch environment scans set this lower, for example 300.
RB_REFERENCE_REBUILD_TIMEOUT=1200

# Network isolation is enabled by default. Set this to 0 only for connectivity
# diagnosis; an unisolated recreation run is not a valid benchmark result.
# RB_WINDOWS_ENABLE_NETWORK_ISOLATION=0
# RB_MODEL_BASE_URL must be directly reachable from Windows. A model router on
# the controller's private network can be used, for example http://10.x.x.x:8918.
# The firewall allows only that endpoint while the recreation agent is running.
# The router must itself restrict forwarding to the intended model upstream;
# a general-purpose open forwarder would let the agent bypass network isolation.
# Optional direct TCP endpoint used as a negative control. It is tested before
# isolation and, when initially reachable, must be blocked after isolation.
# RB_WINDOWS_NETWORK_DENY_PROBE=https://1.1.1.1:443

# VLM judge used by eval/scoring. Both RB_* and VLM_JUDGE_* forms are accepted.
RB_VLM_MODEL=your-vlm-model
RB_VLM_BASE_URL=https://api.example.com/v1
RB_VLM_KEY=sk-xxx
VLM_JUDGE_MODEL=your-vlm-model
VLM_JUDGE_BASE_URL=https://api.example.com/v1
VLM_JUDGE_API_KEY=sk-xxx

# Frozen RecreationBench input on the controller. This directory is the only
# input source and must contain <root>/windows/<task-id>/ or <root>/<task-id>/.
RB_UNIFIED_PLATFORM=windows
RB_UNIFIED_LOCAL_DIR=/absolute/path/to/released-dataset

# Stage and timeout controls.
STAGE=recreation_eval
EVAL_TARGET=recreation
RUNTIME_TIMEOUT_SEC=86400
RB_RECREATION_TIMEOUT=72000
RB_EVAL_TIMEOUT=7200
RECREATION_TIMEOUT=72000
