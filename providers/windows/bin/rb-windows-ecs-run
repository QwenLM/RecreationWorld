#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WINDOWS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATE_DIR="$WINDOWS_ROOT/template"

ENV_FILE="${RB_ENV_FILE:-$TEMPLATE_DIR/.env.windows}"
PYTHON_BIN="${RB_WINDOWS_LOCAL_PYTHON:-python3}"
VENV_PY="$TEMPLATE_DIR/.venv/bin/python"

if [ ! -f "$ENV_FILE" ]; then
  echo "env file not found: $ENV_FILE" >&2
  echo "copy $TEMPLATE_DIR/.env.example to $TEMPLATE_DIR/.env.windows and fill it first" >&2
  exit 66
fi

if [ -x "$VENV_PY" ]; then
  PYTHON_BIN="$VENV_PY"
fi

export RB_ENV_FILE="$ENV_FILE"
exec "$PYTHON_BIN" "$TEMPLATE_DIR/run_one.py" "$@"
