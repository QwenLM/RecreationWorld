E2B_API_KEY=e2b_xxx
E2B_API_URL=https://api.cn-hongkong.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hongkong.e2b.fc.aliyuncs.com

FROM_IMAGE=registry.example.com/recreationbench/web:release-v1
RB_WEB_TEMPLATE_NAME=recreationbench-web-release-v1
RB_WEB_TEMPLATE=

RB_MODEL=your-model-name
RB_MODEL_BASE_URL=https://api.example.com/v1
RB_MODEL_API_KEY=sk-xxx
# Direct-Docker only: set this to pass the model key to the unprivileged Codex
# process. Keep empty/0 for the normal Sandbox path.
RB_DIRECT_MODEL_KEY_TO_AGENT=
# Local controller uses short command requests and polls this interval. State
# files contain the Sandbox ID for explicit recovery after an interrupted run.
RB_POLL_INTERVAL=15
RB_RUN_STATE_DIR=/tmp/recreationbench-web-runs
# A transient controller poll error is retried indefinitely; Sandbox timeout is
# the outer deadline. Use cleanup_run.py to cancel an explicitly abandoned run.
# A key alone does not enable the judge.
USE_VLM_JUDGE=false
RB_VLM_KEY=sk-xxx
RB_VLM_MODEL=your-vlm-model
RB_VLM_BASE_URL=https://api.example.com/v1
RB_VLM_BACKEND=openai-compatible
RB_VLM_MODE=assertion
RB_VLM_MAX_CONCURRENCY=8

RB_UNIFIED_PLATFORM=web
# Local released input. RB_UNIFIED_ARCHIVE takes precedence; otherwise the
# runner searches RB_UNIFIED_CACHE_DIR for the requested task.
RB_UNIFIED_ARCHIVE=/absolute/path/to/task-id.web.tar.gz
RB_UNIFIED_CACHE_DIR=
# Group runs validate and pack local inputs before Sandbox creation.
RB_UNIFIED_PREFETCH_CONCURRENCY=2
RB_UNIFIED_MIN_FREE_GB=8

RB_REPRO_MODE=true
RB_PREFETCH_UNIFIED=true
RB_SANDBOX_ALLOW_INTERNET=true
# Minimum free space left in the Sandbox filesystem after source/input upload
# and extraction. If the task cannot fit, fail before uploading gigabytes.
RB_SANDBOX_MIN_FREE_GB=1
RB_ENABLE_VISUAL=false
RB_WEB_HEADFUL=
RB_VISUAL_GEOMETRY=1280x720x24
RB_VISUAL_WEB_PORT=6080
RB_VISUAL_RFB_PORT=5900
RB_SANDBOX_VPC_CONFIG=

# Optional Web benchmark knobs.
TEMPERATURE=1.0
MAX_ITERATIONS=100
RUNTIME_TIMEOUT_SEC=86400
RB_PERM_SETUP=1
SCAFFOLD_VERSION=
RB_CUA_DRIVER_REF=
RB_CUA_PREFLIGHT_MODE=
ALLOW_IMAGE_READ=true
REPLICATE_ALL_PAGES=false
TIMEOUT_MULTIPLIER=10
RB_API_TIMEOUT_MS=1800000
RB_MCP_TOOL_TIMEOUT=180000
# Browser MCP may need a second start while Chromium fonts initialize in a new
# Sandbox.  This remains a strict functional preflight, not a bypass.
RB_BROWSER_PREFLIGHT_ATTEMPTS=3
RB_BROWSER_PREFLIGHT_RETRY_DELAY_SEC=3
RB_BROWSER_PREFLIGHT_TIMEOUT_SEC=45
