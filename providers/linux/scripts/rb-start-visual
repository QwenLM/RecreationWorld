#!/usr/bin/env bash
set -euo pipefail

truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

if ! truthy "${RB_ENABLE_VISUAL:-}"; then
  exit 0
fi

if [ "${RB_VISUAL_MODE:-}" = "desktop_stream" ]; then
  exit 0
fi

export DISPLAY="${DISPLAY:-:99}"
geometry="${RB_VISUAL_GEOMETRY:-1280x720x24}"
rfb_port="${RB_VISUAL_RFB_PORT:-5900}"
web_port="${RB_VISUAL_WEB_PORT:-6080}"
password_file="${RB_VISUAL_PASSWORD_FILE:-/tmp/rb-visual-password}"
log_dir="${RB_OUTPUT_DIR:-/tmp/recreationbench-output}"
mkdir -p "$log_dir"

if ! xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
  Xvfb "$DISPLAY" -ac -screen 0 "$geometry" +extension GLX +render -noreset \
    >"$log_dir/visual-xvfb.log" 2>&1 &
  for _ in $(seq 1 30); do
    xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break
    sleep 1
  done
fi

if ! xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
  echo "visual_display_failed=$DISPLAY" >&2
  exit 1
fi

if ! pgrep -x openbox >/dev/null 2>&1 && command -v openbox >/dev/null 2>&1; then
  openbox >"$log_dir/visual-openbox.log" 2>&1 &
fi

if [ -n "${RB_VISUAL_PASSWORD:-}" ]; then
  umask 077
  printf '%s' "$RB_VISUAL_PASSWORD" >"$password_file"
elif [ ! -s "$password_file" ]; then
  umask 077
  rb-controller-helper random-token >"$password_file"
fi

pkill -f "x11vnc .* -rfbport ${rfb_port}" >/dev/null 2>&1 || true
pkill -f "websockify .*:${web_port}" >/dev/null 2>&1 || true

x11vnc -display "$DISPLAY" -forever -shared -rfbport "$rfb_port" \
  -passwdfile "$password_file" -listen 127.0.0.1 -noxdamage \
  >"$log_dir/visual-x11vnc.log" 2>&1 &

for _ in $(seq 1 30); do
  if command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 "$rfb_port" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

novnc_web="${RB_NOVNC_WEB:-/usr/share/novnc}"
if [ ! -d "$novnc_web" ]; then
  novnc_web="/usr/share/novnc/web"
fi

websockify --web "$novnc_web" "0.0.0.0:${web_port}" "127.0.0.1:${rfb_port}" \
  >"$log_dir/visual-websockify.log" 2>&1 &

printf 'visual_ready=1 display=%s web_port=%s rfb_port=%s password_file=%s\n' \
  "$DISPLAY" "$web_port" "$rfb_port" "$password_file"
