E2B_API_KEY=e2b_xxx
E2B_API_URL=https://api.cn-hongkong.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hongkong.e2b.fc.aliyuncs.com

FROM_IMAGE=registry.example.com/recreationbench/linux:release-v1
RB_LINUX_TEMPLATE_NAME=recreationbench-linux-release-v1
RB_LINUX_TEMPLATE=

RB_MODEL=claude-opus-5
RB_MODEL_BASE_URL=https://api.example.com/v1
RB_MODEL_API_KEY=sk-xxx
RB_VLM_KEY=sk-xxx
RB_VLM_MODEL=dashscope.qwen3.7-plus
RB_VLM_BASE_URL=https://api.example.com/v1

# Local released input. Set one of these paths on the controller.
RB_UNIFIED_PLATFORM=ubuntu
RB_UNIFIED_ARCHIVE=/absolute/path/to/task-id.ubuntu.tar.gz
RB_UNIFIED_CACHE_DIR=

RB_REPRO_MODE=true
RB_PREFETCH_UNIFIED=true
RB_SANDBOX_ALLOW_INTERNET=true

# Optional noVNC viewer. Prefer enabling this only for single-task debugging.
RB_ENABLE_VISUAL=false
RB_VISUAL_GEOMETRY=1280x720x24
RB_VISUAL_WEB_PORT=6080
RB_VISUAL_RFB_PORT=5900

# Optional Claude recreation tuning. These materially affect
# long desktop tasks with screenshot-heavy trajectories.
CONTEXT_1M=true
AUTO_COMPACT_WINDOW=1048576
THINKING_EFFORT=max
RECREATION_TIMEOUT=72000
RB_CUA_DRIVER_REF=qwen:0.7.3
RB_CUA_PREFLIGHT_MODE=warn

# Optional FC VPC metadata JSON for private model endpoints.
RB_SANDBOX_VPC_CONFIG=
