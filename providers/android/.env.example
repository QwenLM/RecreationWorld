# Direct recreation model: Claude Code speaks Anthropic Messages to this URL.
RB_MODEL=claude-opus-4-8
RB_CLAUDE_MODEL=claude-opus-4-8
RB_MODEL_BASE_URL=https://api.anthropic.com
RB_MODEL_API_KEY=replace-with-your-key
RB_API_MODE=native
RB_AGENT_CLI=claude

# VLM judge: OpenAI Chat Completions-compatible endpoint (base URL ends at /v1).
RB_VLM_MODEL=replace-with-your-vision-model
RB_VLM_BASE_URL=https://your-provider.example/v1
RB_VLM_KEY=replace-with-your-key

# Reliability and model-context settings.
RB_MODEL_MAX_RETRIES=10
RB_CONTEXT_1M=false
RB_AUTO_COMPACT_WINDOW=0
RB_MAX_TOKENS_LIMIT=0
RB_THINKING_EFFORT=high
