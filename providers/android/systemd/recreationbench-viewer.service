[Unit]
Description=RecreationBench Android browser viewer
After=network.target recreationbench-emulator.service
Wants=recreationbench-emulator.service

[Service]
Type=simple
WorkingDirectory=/opt/recreationbench
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=-/etc/recreationbench-viewer.env
ExecStart=/usr/bin/python3 /opt/recreationbench/providers/android/viewer/server.py --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
