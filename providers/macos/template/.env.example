# macOS SSH endpoint.
MACOS_HOST=
MACOS_SSH_PORT=22
MACOS_USERNAME=
MACOS_PASSWORD=
# Optional alternative to password authentication.
MACOS_SSH_KEY=

# Remote directory used only by this benchmark runtime.
MACOS_PIPELINE_DIR=$HOME/recreationbench
MACOS_DEVAGENT_USER=devagent
MACOS_DEVAGENT_PASSWORD=

# Agent model. These credentials are passed to the configured macOS environment.
RB_AGENT_CLI=codex
RB_MODEL=
RB_MODEL_BASE_URL=https://api.example.com/v1
RB_MODEL_API_KEY=
RB_CODEX_VERSION=0.145.0
RB_CLAUDE_VERSION=2.1.177

# VLM judge.
RB_VLM_MODEL=
RB_VLM_KEY=
RB_VLM_BASE_URL=https://api.example.com/v1

# Evaluation input. Set either a prepared local dataset directory or archive.
RB_UNIFIED_LOCAL_DIR=
RB_UNIFIED_ARCHIVE=/absolute/path/to/task-id.macos.tar.gz
RB_UNIFIED_CACHE_DIR=

# Optional task/runtime tuning.
RB_RESULT_DIR=results/macos
RB_RECREATION_TIMEOUT=72000
RB_TOTAL_TIMEOUT=86400
RB_EFFORT=max
RB_ENABLE_CUA_DRIVER=true
